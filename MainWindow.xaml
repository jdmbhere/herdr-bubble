<Window x:Class="HerdrBubble.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Herdr Bubble"
        Width="120"
        Height="120"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style TargetType="ContextMenu" x:Key="DarkContextMenu">
            <Setter Property="Background" Value="#E6161922" />
            <Setter Property="Foreground" Value="#F3F5FA" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.55" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem" x:Key="DarkMenuItem">
            <Setter Property="Foreground" Value="#EEF1F8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                Margin="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CheckMark"
                                           Grid.Column="0"
                                           Text="●"
                                           FontSize="8"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="#5CE1E6"
                                           Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#66EEF1F8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <!-- Black hole singularity void behind the bubble -->
        <Ellipse x:Name="SingularityVoid"
                 Width="66"
                 Height="66"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Opacity="0"
                 IsHitTestVisible="False"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#FF000000" Offset="0.0" />
                    <GradientStop Color="#F2040408" Offset="0.58" />
                    <GradientStop Color="#CC4C1D95" Offset="0.80" />
                    <GradientStop Color="#666EF3D6" Offset="0.93" />
                    <GradientStop Color="#00000000" Offset="1.0" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="VoidScale" ScaleX="0.2" ScaleY="0.2" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Swirling accretion disk -->
        <Ellipse x:Name="AccretionRing"
                 Width="72"
                 Height="72"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 StrokeThickness="2.4"
                 StrokeDashArray="5 3 2 3"
                 StrokeDashCap="Round"
                 Opacity="0"
                 IsHitTestVisible="False"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF6EF3D6" Offset="0.0" />
                    <GradientStop Color="#FFA855F7" Offset="0.5" />
                    <GradientStop Color="#FF38BDF8" Offset="1.0" />
                </LinearGradientBrush>
            </Ellipse.Stroke>
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="AccretionScale" ScaleX="0.4" ScaleY="0.4" />
                    <RotateTransform x:Name="AccretionRotate" Angle="0" />
                </TransformGroup>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Gravitational shockwave ripple on click -->
        <Ellipse x:Name="RippleRing"
                 Width="62"
                 Height="62"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 StrokeThickness="2"
                 Opacity="0"
                 IsHitTestVisible="False"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#74F2CE" Offset="0" />
                    <GradientStop Color="#A855F7" Offset="0.5" />
                    <GradientStop Color="#7C8BFF" Offset="1" />
                </LinearGradientBrush>
            </Ellipse.Stroke>
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="RippleScale" ScaleX="1" ScaleY="1" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Main floating bubble -->
        <Grid x:Name="BubbleContainer"
              Width="62"
              Height="62"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Cursor="Hand"
              RenderTransformOrigin="0.5,0.5"
              MouseLeftButtonDown="Bubble_MouseLeftButtonDown"
              MouseMove="Bubble_MouseMove"
              MouseLeftButtonUp="Bubble_MouseLeftButtonUp"
              MouseRightButtonUp="Bubble_MouseRightButtonUp"
              MouseEnter="Bubble_MouseEnter"
              MouseLeave="Bubble_MouseLeave">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BubbleScale" ScaleX="1" ScaleY="1" />
                    <RotateTransform x:Name="BubbleRotate" Angle="0" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Grid.Effect>
                <DropShadowEffect x:Name="BubbleShadow"
                                  Color="#000000"
                                  BlurRadius="22"
                                  ShadowDepth="5"
                                  Direction="270"
                                  Opacity="0.62" />
            </Grid.Effect>

            <!-- Outer specular glass rim -->
            <Ellipse>
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0.15,0.05" EndPoint="0.85,0.95">
                        <GradientStop Color="#66FFFFFF" Offset="0.0" />
                        <GradientStop Color="#22A6B8FF" Offset="0.48" />
                        <GradientStop Color="#14FFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Inner dark obsidian sphere -->
            <Ellipse Margin="1.5">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.32,0.24" Center="0.45,0.42" RadiusX="0.7" RadiusY="0.7">
                        <GradientStop Color="#2A3142" Offset="0.0" />
                        <GradientStop Color="#161A24" Offset="0.55" />
                        <GradientStop Color="#0B0E14" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Soft top glass sheen -->
            <Ellipse Width="42"
                     Height="22"
                     VerticalAlignment="Top"
                     Margin="0,4,0,0"
                     IsHitTestVisible="False">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#30FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Terminal >_ vector glyph -->
            <Canvas Width="28" Height="22" IsHitTestVisible="False">
                <Path Data="M 4,5 L 12,11 L 4,17"
                      Stroke="#F4F7FF"
                      StrokeThickness="2.6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
                <Line X1="14.5" Y1="17"
                      X2="24" Y2="17"
                      Stroke="#6EF3D6"
                      StrokeThickness="2.6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
            </Canvas>

            <!-- Status indicator dot (bottom-right) -->
            <Ellipse x:Name="StatusDot"
                     Width="12"
                     Height="12"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,0,4,4"
                     Fill="#38D399"
                     Stroke="#0E1118"
                     StrokeThickness="2"
                     IsHitTestVisible="False" />
        </Grid>
    </Grid>
</Window>
